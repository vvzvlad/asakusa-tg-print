.git
.venv/
venv/
__pycache__/
*.pyc
.env
data/
tests/
# CI lives outside the image. Today's Dockerfile copies named paths rather than the whole tree,
# so none of this could reach the runtime image anyway — but it is still shipped to the daemon
# as build context on every build, and a future `COPY . .` would quietly bake the workflows and
# the smoke gate into the image. `.github/` stays listed although the workflow in it has been
# replaced: a mirror or a lint workflow reappearing there should not become a build input again.
.github/
.gitea/
ci/
*.md
.DS_Store

# dev/test-only — never needed in the runtime image
requirements-dev.txt
pytest.ini
.pytest_cache/
.coverage
